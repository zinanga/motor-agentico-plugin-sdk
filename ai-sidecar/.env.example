# motor-ai-sidecar — keys de NUBE (opcionales). Copia a `.env` y rellena lo que uses.
# Los modelos LOCALES (Ollama / LM Studio) NO necesitan key.
# Este .env es del sidecar: NO toca el .env del Motor ni el de Hermes.

# OpenRouter = una key, cualquier modelo en la nube (recomendado para nube).
OPENROUTER_API_KEY=

# OpenAI directo (opcional)
OPENAI_API_KEY=

# Anthropic directo (opcional)
ANTHROPIC_API_KEY=

# Overrides (opcionales)
# MOTOR_AI_PORT=8899
# OLLAMA_URL=http://localhost:11434/v1
# LMSTUDIO_URL=http://localhost:1234/v1
